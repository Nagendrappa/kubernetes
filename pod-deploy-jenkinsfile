pipeline {
    agent any

    environment {
        GIT_URL = "https://github.com/Nagendrappa/kubernetes.git"
        GIT_BRANCH = "*/main"
        K8s_MANIFEST_DIR = "k8s"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: "${GIT_BRANCH}"]],
                    userRemoteConfigs: [[url: "${GIT_URL}"]]
                ])
            }
        }

        stage('Deploy to Minikube (Deployment + NodePort)') {
            steps {
                withCredentials([file(credentialsId: 'minikube', variable: 'KCFG')]) {
                    sh '''
                        set -e
                        export KUBECONFIG="$KCFG"
                        rm -rf /tmp/k8s || true
                        mkdir -p /tmp/k8s
                        cp -r ${K8s_MANIFEST_DIR}/* /tmp/k8s/
                        kubectl apply -f /tmp/k8s/
                    '''
                }
            }
        }
    }
}